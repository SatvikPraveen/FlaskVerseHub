# Copy to .env and adjust. Every variable is optional in development; production
# refuses to start without SECRET_KEY and DATABASE_URL.

# --- Core -------------------------------------------------------------------
FLASK_CONFIG=development            # development | testing | production
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flaskversehub
# DEV_DATABASE_URL=sqlite:///instance/dev.db

# --- Cache, rate limiting, real-time ----------------------------------------
# CACHE_TYPE=RedisCache             # SimpleCache (default in dev) | RedisCache | NullCache
# CACHE_REDIS_URL=redis://localhost:6379/1
# RATELIMIT_STORAGE_URI=redis://localhost:6379/2
# RATELIMIT_DEFAULT=300 per minute
# RATELIMIT_AUTH=10 per minute
# RATELIMIT_API=120 per minute
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/3   # required with >1 gunicorn worker
# SOCKETIO_ASYNC_MODE=threading     # threading | gevent

# --- Security ---------------------------------------------------------------
# SESSION_COOKIE_SECURE=true
# JWT_SECRET_KEY=                   # defaults to SECRET_KEY
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=30
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
# SECURITY_HEADERS_ENABLED=true

# --- Mail -------------------------------------------------------------------
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@example.com
# MAIL_SUPPRESS_SEND=false

# --- Retrieval engine -------------------------------------------------------
# SEARCH_RANKER=bm25                # bm25 | bm25plus | tfidf
# SEARCH_BM25_K1=1.5
# SEARCH_BM25_B=0.75
# SEARCH_INDEX_TTL_SECONDS=60

# --- Observability ----------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_JSON=false
# METRICS_ENABLED=true
# SENTRY_DSN=
# SLOW_QUERY_THRESHOLD_SECONDS=0.5
